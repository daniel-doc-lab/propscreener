# Kopiér til .env (eller sæt som GitHub Actions secrets). Alle er valgfrie –
# pipelinen degraderer pænt og markerer i output hvilke kilder der var aktive.

# --- Statstidende (Civilstyrelsen) -------------------------------------------
# mode: "api" (OCES3-certifikat, aftale med Civilstyrelsen) eller "web" (offentlig søgning)
STATSTIDENDE_MODE=web
STATSTIDENDE_API_BASE=https://api.statstidende.dk
STATSTIDENDE_WEB_BASE=https://www.statstidende.dk
# Sti til klientcertifikat (PEM) + nøgle, kun for mode=api
STATSTIDENDE_CERT_FILE=
STATSTIDENDE_KEY_FILE=

# --- CVR ---------------------------------------------------------------------
# cvrapi.dk kræver en beskrivende User-Agent med kontaktinfo
CVRAPI_USER_AGENT="propscreener/0.1 (github.com/daniel-doc-lab/propscreener; kontakt: din@email.dk)"
# Valgfrit: Erhvervsstyrelsens system-til-system adgang (Elasticsearch)
CVR_ES_USER=
CVR_ES_PASSWORD=

# --- Datafordeler (Ejerfortegnelsen, Vurdering) -----------------------------
# Opret tjenestebruger på datafordeler.dk (gratis)
DATAFORDELER_USER=
DATAFORDELER_PASSWORD=

# --- Pipeline ----------------------------------------------------------------
PROPSCREENER_DAYS_BACK=90
PROPSCREENER_MIN_SCORE=40
PROPSCREENER_CACHE_DIR=.cache
